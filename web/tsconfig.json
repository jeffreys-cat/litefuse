{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "outDir": "dist",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "store/*": ["./src/pages/project/[projectId]/discover/store/*"],
      "services/*": ["./src/pages/project/[projectId]/discover/services/*"],
      "components/*": ["./src/pages/project/[projectId]/discover/components/*"],
      "types/*": ["./src/pages/project/[projectId]/discover/types/*"],
      "utils/*": ["./src/pages/project/[projectId]/discover/utils/*"],
      "@grafana/data": [
        "./src/pages/project/[projectId]/discover/shims/grafana-data"
      ],
      "@grafana/runtime": [
        "./src/pages/project/[projectId]/discover/shims/grafana-runtime"
      ],
      "jotai-location": [
        "./src/pages/project/[projectId]/discover/shims/jotai-location"
      ],
      "antd": ["./src/pages/project/[projectId]/discover/shims/antd"],
      "react-i18next": [
        "./src/pages/project/[projectId]/discover/shims/react-i18next"
      ]
    },
    "strictNullChecks": true
  },
  "exclude": ["node_modules", "sdk"],
  "include": [
    "**/*.cjs",
    "**/*.mjs",
    "**/*.ts",
    "**/*.tsx",
    ".eslintrc.js",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "next-env.d.ts",
    "src",
    "types/global.d.ts",
    ".next-check/types/**/*.ts"
  ]
}
